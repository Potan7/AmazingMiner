.factory-screen {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    pointer-events: none;
}

.factory-header {
    background-color: rgba(15, 25, 20, 0.9);
    border-bottom-width: 2px;
    border-color: #00FF55;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    pointer-events: auto;
}

.factory-title {
    font-size: 18px;
    font-weight: bold;
    color: #00FF55;
}

.btn-exit {
    background-color: #d9534f;
    border-radius: 4px;
    border-width: 0px;
    color: #FFFFFF;
    font-weight: bold;
    padding: 6px 14px;
}

.btn-exit:hover {
    background-color: #c9302c;
}

.factory-bottom-panel {
    background-color: rgba(15, 20, 25, 0.9);
    border-top-width: 2px;
    border-color: #0088FF;
    flex-direction: row;
    justify-content: space-around;
    padding: 15px 30px;
    pointer-events: auto;
}

.factory-status-item {
    align-items: center;
}

.status-label {
    font-size: 13px;
    color: #888888;
    margin-bottom: 4px;
}

.status-value {
    font-size: 15px;
    font-weight: bold;
    color: #FFFFFF;
}

.status-value-stable {
    font-size: 15px;
    font-weight: bold;
    color: #00FF55;
}
