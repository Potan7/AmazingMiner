.shop-subtitle {
    font-size: 14px;
    color: #AAAAAA;
    margin-bottom: 8px;
}

.shop-list {
    flex-grow: 1;
}

.shop-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(50, 50, 50, 0.5);
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 6px;
}

.item-name {
    font-size: 14px;
    font-weight: bold;
}

.btn-buy {
    background-color: #007ACC;
    border-radius: 4px;
    border-width: 0px;
    color: #FFFFFF;
    padding: 4px 10px;
}

.btn-buy:hover {
    background-color: #0098FF;
}
