.storage-subtitle {
    font-size: 14px;
    color: #AAAAAA;
    margin-bottom: 12px;
}

.storage-grid-container {
    flex-grow: 1;
}

.grid-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.slot-item {
    width: 70px;
    height: 70px;
    background-color: rgba(50, 50, 50, 0.6);
    border-width: 1.5px;
    border-color: #555555;
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    position: relative;
}

.slot-item:hover {
    border-color: #00FFCC;
    background-color: rgba(70, 70, 70, 0.8);
}

.slot-icon {
    font-size: 28px;
}

.slot-count {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 11px;
    color: #00FFCC;
    font-weight: bold;
}
